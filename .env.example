# Copy to .env and fill in the value. Never commit a real .env.
#
# The app looks for .env in this repo folder first, then in the folder one
# level above it (that is where the teaching staff keep their key).
#
# The model name is NOT set here — it lives in backend/config.py, so the one
# model this project uses (gpt-6-luna) is named in exactly one place.

PORTKEY_API_KEY=
